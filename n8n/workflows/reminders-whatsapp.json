{
  "name": "Bumera - Lembretes por WhatsApp",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "name": "A cada 5 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "http://app:3000/api/v1/reminders/due",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "limit",
              "value": "20"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      },
      "name": "Buscar lembretes devidos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Bumera service key"
        }
      }
    },
    {
      "parameters": {
        "fieldToSplitOut": "data",
        "options": {}
      },
      "name": "Uma por lembrete",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://evolution:8080/message/sendText/bumera-teste",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.patient.phone.replace(/\\D/g, ''), text: $json.message }) }}",
        "options": {
          "timeout": 30000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 4000
            }
          }
        }
      },
      "name": "Enviar pela Evolution",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Evolution API key"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://app:3000/api/v1/reminders/{{ $('Uma por lembrete').item.json.id }}/result",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ outcome: 'sent', attempt: $('Uma por lembrete').item.json.attempt }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "name": "Reportar enviado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        -100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Bumera service key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://app:3000/api/v1/reminders/{{ $('Uma por lembrete').item.json.id }}/result",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ outcome: 'failed', attempt: $('Uma por lembrete').item.json.attempt, error: 'evolution_send_failed' }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "name": "Reportar falha",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Bumera service key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "A cada 5 minutos": {
      "main": [
        [
          {
            "node": "Buscar lembretes devidos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar lembretes devidos": {
      "main": [
        [
          {
            "node": "Uma por lembrete",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Uma por lembrete": {
      "main": [
        [
          {
            "node": "Enviar pela Evolution",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar pela Evolution": {
      "main": [
        [
          {
            "node": "Reportar enviado",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reportar falha",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Sao_Paulo"
  }
}