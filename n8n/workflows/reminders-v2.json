{
  "id": "bnwruBnpnSy151QN",
  "name": "Bumera - Lembretes por WhatsApp (v2)",
  "description": "Envia os lembretes do Bumera (confirmação, 24 h, 2 h, falta, retomada, orçamento). O app decide quem e quando; este fluxo monta o texto de cada tipo.",
  "versionId": "fd2baab4-6f0a-45bb-ae06-2b2aed2d46cf",
  "nodes": [
    {
      "id": "944e8a7f-1150-4509-960c-f64160e71356",
      "name": "A cada minuto",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        672
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "0041c7e1-30b9-468b-9d93-8254fe0611e8",
      "name": "Buscar lembretes devidos",
