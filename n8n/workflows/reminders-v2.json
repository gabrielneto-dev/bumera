            {
              "id": "texto",
              "name": "texto",
              "type": "string",
              "value": "={{ $json.ola }}\n\n{{ $json.dependente ? 'Sentimos a falta de *' + $json.quem + '* na consulta de ' + $json.quando + ' na ' + $json.clinica + '.' : 'Sentimos sua falta na consulta de ' + $json.quando + ' na ' + $json.clinica + '.' }}\n\nQuer remarcar? Responda *2* e nossa equipe entra em contato.\n\nPara não receber mais mensagens, responda *SAIR*."
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "0fb41dd6-c669-4ce1-b9cd-041addbc21a2",
      "name": "Texto: Retomada",
