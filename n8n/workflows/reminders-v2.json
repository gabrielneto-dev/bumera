        "assignments": {
          "assignments": [
            {
              "id": "texto",
              "name": "texto",
              "type": "string",
              "value": "={{ $json.ola }}\n\n{{ $json.dependente ? 'Lembrete: *' + $json.quem + '* tem uma consulta na ' + $json.clinica + '.' : 'Lembrete: você tem uma consulta na ' + $json.clinica + '.' }}\n\n{{ $json.detalhes }}\n\nResponda:\n*1* para confirmar\n*2* para remarcar\n\nPara não receber mais mensagens, responda *SAIR*."
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "e753bc7a-1dd9-4664-aea8-5b246b7ac042",
      "name": "Texto: Lembrete 2 h",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1120,
        384
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "texto",
              "name": "texto",
              "type": "string",
              "value": "={{ $json.ola }}\n\n{{ $json.dependente ? 'Lembrete: a consulta de *' + $json.quem + '* na ' + $json.clinica + ' está chegando.' : 'Lembrete: sua consulta na ' + $json.clinica + ' está chegando.' }}\n\n{{ $json.detalhes }}\n\nAté já!"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "bd88b5fd-c2a3-4473-80c0-29b36bfdbd4d",
      "name": "Texto: Falta",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
