    {
      "id": "acba7bb0-4450-47db-8615-d9a88260bfb6",
      "name": "Texto: Confirmação",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "texto",
              "name": "texto",
              "type": "string",
              "value": "={{ $json.ola }}\n\n{{ $json.dependente ? 'A consulta de *' + $json.quem + '* na ' + $json.clinica + ' foi agendada.' : 'Sua consulta na ' + $json.clinica + ' foi agendada.' }}\n\n{{ $json.detalhes }}\n\nResponda:\n*1* para confirmar\n*2* para remarcar\n\nPara não receber mais mensagens, responda *SAIR*."
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "cadc3b9a-908a-424a-aa8b-037060c445a6",
      "name": "Enviar pela Evolution",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1344,
        576
      ],
      "parameters": {
        "method": "POST",
        "url": "=http://bumera-evolution:8080/message/sendText/{{ $json.whatsapp.instance }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.patient.phone.replace(/\\D/g, ''), text: $json.texto, delay: 1200 }) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 4000
            }
          },
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "DFN8nEBbLbdlzqpX",
          "name": "Evolution API key"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "0b5d40be-ffb7-4774-b55f-fcd5b4627953",
