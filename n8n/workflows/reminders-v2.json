              "id": "texto",
              "name": "texto",
              "type": "string",
              "value": "={{ $json.ola }}\n\n{{ $json.dependente ? 'Faz um tempo desde o atendimento de *' + $json.quem + '* na ' + $json.clinica + ' (' + $json.procedimento + '). Que tal agendar o retorno?' : 'Faz um tempo desde o seu atendimento na ' + $json.clinica + ' (' + $json.procedimento + '). Que tal agendar o seu retorno?' }}\n\nResponda:\n*1* para agendar\n*2* para agora não\n\nPara não receber mais mensagens, responda *SAIR*."
            }
          ]
        },
        "options": {}
      }
