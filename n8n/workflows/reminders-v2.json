      "typeVersion": 4.2,
      "position": [
        224,
        672
      ],
      "parameters": {
        "url": "http://bumera-app:3000/api/v1/reminders/due",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "limit",
              "value": "20"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "YZSzgaHSl5XbQpHb",
          "name": "Bumera service key"
        }
      }
    },
    {
      "id": "9ea2361b-7736-46ac-8cdf-c304c4e1605c",
      "name": "Uma por lembrete",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        448,
        672
      ],
      "parameters": {
        "fieldToSplitOut": "data",
        "options": {}
      }
    },
    {
      "id": "3feb4f31-0739-43c5-90df-2e20f5761a7a",
      "name": "Dados da mensagem",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        672,
        672
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "ola",
              "name": "ola",
              "type": "string",
              "value": "={{ (n => n ? 'Olá, ' + n + '!' : 'Olá!')($json.patient.dependent ? $json.patient.guardianFirstName : $json.patient.firstName) }}"
            },
            {
              "id": "quem",
              "name": "quem",
              "type": "string",
              "value": "={{ $json.patient.firstName }}"
            },
            {
              "id": "dependente",
              "name": "dependente",
              "type": "boolean",
              "value": "={{ $json.patient.dependent }}"
            },
            {
              "id": "clinica",
              "name": "clinica",
              "type": "string",
              "value": "={{ '*' + $json.clinic.name + '*' }}"
            },
            {
              "id": "quando",
              "name": "quando",
              "type": "string",
              "value": "={{ $json.appointment ? $json.appointment.day + ' às ' + $json.appointment.time : '' }}"
            },
            {
              "id": "procedimento",
              "name": "procedimento",
              "type": "string",
              "value": "={{ $json.appointment ? $json.appointment.procedureName : '' }}"
            },
            {
              "id": "detalhes",
              "name": "detalhes",
              "type": "string",
              "value": "={{ $json.appointment ? '📅 ' + $json.appointment.day + ' às ' + $json.appointment.time + '\\n🦷 ' + $json.appointment.procedureName + '\\n👤 ' + $json.appointment.dentistName : '' }}"
            },
            {
              "id": "orcamento",
              "name": "orcamento",
              "type": "string",
              "value": "={{ $json.quote ? $json.quote.description : '' }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "7c9516e6-0ffc-4cdd-8917-6ffb13690ec7",
      "name": "Separar por tipo",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        896,
        576
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "renameOutput": true,
              "outputKey": "Confirmação",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.kind }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "CONFIRMATION"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "renameOutput": true,
              "outputKey": "Lembrete 24 h",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.kind }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "REMINDER_24H"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "renameOutput": true,
              "outputKey": "Lembrete 2 h",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.kind }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "REMINDER_2H"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "renameOutput": true,
              "outputKey": "Falta",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.kind }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "NO_SHOW_FOLLOWUP"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "renameOutput": true,
              "outputKey": "Retomada",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.kind }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "REACTIVATION"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "renameOutput": true,
              "outputKey": "Orçamento 1",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.kind }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "QUOTE_FOLLOWUP_1"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "renameOutput": true,
              "outputKey": "Orçamento 2",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.kind }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "QUOTE_FOLLOWUP_2"
                  }
                ],
                "combinator": "and"
              }
            }
