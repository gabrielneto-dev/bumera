    {
      "id": "a5dd1c0c-3429-483e-a13c-d176b8bdb56a",
      "name": "Texto: Lembrete 24 h",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1120,
        192
      ],
      "parameters": {
