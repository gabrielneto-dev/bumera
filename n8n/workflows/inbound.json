    {
      "id": "9f5b4e7d-2d01-4f27-bc8f-d8403451b1af",
      "name": "Decidir o bloco",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Runs after the wait. Only the execution of the block's newest message answers it.\n// \"SAIR\" anywhere in the block wins; otherwise only a command sent as the block's last\n// message counts (\"1\" followed by free text is left for the team).\nconst rows = $input.all().map((item) => item.json).sort((a, b) => a.id - b.id);\nconst mine = $('Ler mensagem').first().json;\nconst last = rows[rows.length - 1];\nif (!last || last.messageId !== mine.messageId) return [];\nconst optOut = rows.some((row) => row.command === 'OPT_OUT');\nreturn [{ json: { instance: mine.instance, phone: mine.phone, answer: optOut ? 'OPT_OUT' : last.command, lastRowId: last.id } }];"
      }
    },
