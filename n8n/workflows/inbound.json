    {
      "id": "00cd3e5f-6717-4cbc-9fd5-e0fd9378d997",
      "name": "Ler mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Evolution \"messages.upsert\": keeps a person's own 1:1 text or media message and\n// drops our messages, groups, broadcasts, reactions and other events.\n// Only the recognised command is kept, never the text itself.\nconst OPT_OUT = ['sair', 'parar', 'pare', 'descadastrar', 'cancelar mensagens'];\nconst MEDIA = ['audioMessage', 'imageMessage', 'videoMessage', 'documentMessage', 'documentWithCaptionMessage'];\n\nconst normalize = (text) => text.normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase()\n  .replace(/[^a-z0-9 ]/g, ' ').replace(/\\s+/g, ' ').trim();\n\n// Whole-message matches only: a sentence that merely contains a keyword is not a command.\nfunction commandOf(text) {\n  const normalized = normalize(text);\n  if (normalized === '1') return 'CONFIRM';\n  if (normalized === '2') return 'RESCHEDULE';\n  if (OPT_OUT.includes(normalized)) return 'OPT_OUT';\n  return '';\n}\n\n// \"5511987654321@s.whatsapp.net\" -> \"5511987654321\"; null for groups, broadcasts and foreign numbers.\nfunction phoneOf(jid) {\n  if (typeof jid !== 'string' || !jid.endsWith('@s.whatsapp.net')) return null;\n  const digits = jid.slice(0, jid.indexOf('@')).replace(/\\D/g, '');\n  return /^55\\d{10,11}$/.test(digits) ? digits : null;\n}\n\nfunction textOf(message) {\n  if (typeof message.conversation === 'string' && message.conversation) return message.conversation;\n  const extended = message.extendedTextMessage;\n  if (extended && typeof extended.text === 'string' && extended.text) return extended.text;\n  return MEDIA.some((field) => field in message) ? '' : null;\n}\n\nconst out = [];\nfor (const item of $input.all()) {\n  const body = item.json.body || {};\n  if (String(body.event || '').toLowerCase().replace(/_/g, '.') !== 'messages.upsert') continue;\n  const data = Array.isArray(body.data) ? body.data[0] : body.data;\n  const key = (data && data.key) || {};\n  if (key.fromMe === true) continue;\n  // WhatsApp may hide the number behind a @lid id and send the real one alongside.\n  const phone = phoneOf(key.remoteJid) || phoneOf(key.remoteJidAlt);\n  const text = textOf((data && data.message) || {});\n  if (!body.instance || !phone || !key.id || text === null) continue;\n  out.push({ json: { instance: String(body.instance), phone, messageId: String(key.id), command: commandOf(text) } });\n}\nreturn out;"
      }
    },
