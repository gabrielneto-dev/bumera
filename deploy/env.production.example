# Names only. Real values live in ~/bumera/.env on the server (chmod 600), never in git.
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=
PGADMIN_PASSWORD=
BETTER_AUTH_SECRET=      # >= 32 chars
CPF_ENCRYPTION_KEY=      # base64 of 32 random bytes
CPF_HASH_KEY=            # base64 of 32 random bytes (different from the encryption key)
SERVICE_API_KEY=         # >= 32 chars; same value goes into the n8n "Bumera service key" credential
EVOLUTION_API_KEY=       # same value goes into the n8n "Evolution API key" credential
