// NOTE: models up to the Bumera marker are generated by `npx auth@latest generate`
// (Better Auth). Re-running it overwrites this file: copy the Bumera section back,
// or generate into a scratch file and merge. `Organization` == clinic (tenant).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id           String        @id
  name         String
  slug         String
  logo         String?
  createdAt    DateTime
  metadata     String?
  members      Member[]
  invitations  Invitation[]
  dentists     Dentist[]
  procedures   Procedure[]
  patients     Patient[]
  appointments Appointment[]
  reminders    Reminder[]
  quotes       Quote[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ---------------------------------------------------------------------------
// BUMERA MODELS (hand-written). Every tenant table carries organizationId and is
// accessed only through lib/tenant-scope.ts.
// ---------------------------------------------------------------------------

enum PatientStatus {
  PENDING
  CONFIRMED
}

enum RecordSource {
  SECRETARY
  WHATSAPP
}

enum AppointmentStatus {
  PENDING
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// Composite (id, organizationId) keys + composite foreign keys make it impossible at the
// database level for a row to reference data of another clinic. Relations use NoAction so
// deleting a clinic can cascade through every table.

model Dentist {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  active         Boolean       @default(true)
  /// Simple working window in the clinic's local time ("HH:MM") and weekdays (0 = Sunday).
  workStart      String        @default("08:00")
  workEnd        String        @default("18:00")
  workDays       Int[]         @default([1, 2, 3, 4, 5, 6])
  createdAt      DateTime      @default(now())
  appointments   Appointment[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("dentist")
}

model Procedure {
  id                    String        @id @default(uuid())
  organizationId        String
  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                  String
  defaultDurationMin    Int           @default(30)
  /// Months after a completed appointment to invite the patient back (module 1); null = never.
  reactivateAfterMonths Int?
  active                Boolean       @default(true)
  createdAt             DateTime      @default(now())
  appointments          Appointment[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("procedure")
}

model Patient {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  /// AES-256-GCM payload (lib/crypto.ts); null for patients without CPF.
  cpfEncrypted   String?
  /// Keyed hash of the CPF digits, used for the per-clinic uniqueness rule.
  cpfHash        String?
  phoneE164      String
  birthDate      DateTime?     @db.Date
  status         PatientStatus @default(CONFIRMED)
  source         RecordSource  @default(SECRETARY)
  consentAt      DateTime?
  consentSource  String?
  doNotContact   Boolean       @default(false)
  optedOutAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  appointments   Appointment[]
  quotes         Quote[]

  @@unique([id, organizationId])
  @@unique([organizationId, cpfHash])
  @@index([organizationId, name])
  @@index([organizationId, phoneE164])
  @@map("patient")
}

model Appointment {
  id                    String            @id @default(uuid())
  organizationId        String
  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientId             String
  dentistId             String
  procedureId           String
  patient               Patient           @relation(fields: [patientId, organizationId], references: [id, organizationId], onDelete: NoAction)
  dentist               Dentist           @relation(fields: [dentistId, organizationId], references: [id, organizationId], onDelete: NoAction)
  procedure             Procedure         @relation(fields: [procedureId, organizationId], references: [id, organizationId], onDelete: NoAction)
  startsAt              DateTime
  endsAt                DateTime
  status                AppointmentStatus @default(SCHEDULED)
  source                RecordSource      @default(SECRETARY)
  createdById           String?
  /// Set when the patient answered "2" (reschedule) on WhatsApp; the secretary follows up.
  rescheduleRequestedAt DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  reminders             Reminder[]

  @@unique([id, organizationId])
  @@index([organizationId, startsAt])
  @@index([dentistId, startsAt])
  @@map("appointment")
}

// ---------------------------------------------------------------------------
// M2: reminders. One row per (appointment, kind), recomputed in the same transaction
// as appointment changes (lib/reminders/sync.ts) and handed to n8n by polling
// (lib/reminders/dispatch.ts).
// ---------------------------------------------------------------------------

enum ReminderKind {
  CONFIRMATION
  REMINDER_24H
  REMINDER_2H
  NO_SHOW_FOLLOWUP
  /// Automatic answers to a patient's WhatsApp reply (1, 2, SAIR); sent through the same n8n flow.
  REPLY_CONFIRMED
  REPLY_RESCHEDULE
  REPLY_OPTED_OUT
  /// Module 1: invite the patient back N months after a completed appointment.
  REACTIVATION
  REPLY_INTERESTED
  REPLY_DECLINED
  /// Module 2: follow-ups after a quote was given (day 2 and day 7).
  QUOTE_FOLLOWUP_1
  QUOTE_FOLLOWUP_2
}

/// What the patient answered to a campaign message (reactivation).
enum ReminderAnswer {
  INTERESTED
  DECLINED
}

enum ReminderStatus {
  /// Waiting for dueAt (also used while waiting to retry after a failure).
  PENDING
  /// Handed to n8n; waiting for its result.
  CLAIMED
  SENT
  /// Out of attempts: the secretary is alerted.
  FAILED
  /// No longer needed (appointment changed) or stale.
  CANCELLED
  /// Not allowed (opt-out, no consent).
  SKIPPED
}

model Reminder {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Exactly one of appointmentId / quoteId is set (CHECK constraint in the migration).
  appointmentId  String?
  appointment    Appointment?    @relation(fields: [appointmentId, organizationId], references: [id, organizationId], onDelete: NoAction)
  quoteId        String?
  quote          Quote?          @relation(fields: [quoteId, organizationId], references: [id, organizationId], onDelete: NoAction)
  kind           ReminderKind
  status         ReminderStatus  @default(PENDING)
  /// Earliest moment n8n may pick it up; moved forward on retries.
  dueAt          DateTime
  attempts       Int             @default(0)
  claimedAt      DateTime?
  sentAt         DateTime?
  /// Patient's answer to a campaign message, when it was given, and when the secretary dealt with it.
  answer         ReminderAnswer?
  answeredAt     DateTime?
  handledAt      DateTime?
  /// Why it was cancelled/skipped, or the last delivery error. Never holds message text or PII.
  note           String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([appointmentId, kind])
  @@unique([quoteId, kind])
  @@index([status, dueAt])
  @@index([organizationId, status])
  @@map("reminder")
}

// ---------------------------------------------------------------------------
// Module 2: quotes. The secretary records a quote; the app schedules follow-up reminders
// (lib/reminders/plan.ts) delivered through the same n8n flow as appointment reminders.
// ---------------------------------------------------------------------------

enum QuoteStatus {
  OPEN
  ACCEPTED
  DECLINED
}

model Quote {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient      @relation(fields: [patientId, organizationId], references: [id, organizationId], onDelete: NoAction)
  /// What was quoted ("Implante dente 36"); shown in the follow-up message.
  description    String
  valueCents     Int?
  status         QuoteStatus  @default(OPEN)
  closedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  reminders      Reminder[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@map("quote")
}
