// NOTE: models up to the Bumera marker are generated by `npx auth@latest generate`
// (Better Auth). Re-running it overwrites this file: copy the Bumera section back,
// or generate into a scratch file and merge. `Organization` == clinic (tenant).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id              String           @id
  name            String
  slug            String
  logo            String?
  createdAt       DateTime
  metadata        String?
  members         Member[]
  invitations     Invitation[]
  dentists        Dentist[]
  procedures      Procedure[]
  patients        Patient[]
  appointments    Appointment[]
  reminders       Reminder[]
  quotes          Quote[]
  clinicSettings  ClinicSettings?
  auditLogs       AuditLog[]
  inboundMessages InboundMessage[]
  conversations   Conversation[]
  inboundBuffers  InboundBuffer[]
  aiEvents        AiEvent[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ---------------------------------------------------------------------------
// BUMERA MODELS (hand-written). Every tenant table carries organizationId and is
// accessed only through lib/tenant-scope.ts.
// ---------------------------------------------------------------------------

enum PatientStatus {
  PENDING
  CONFIRMED
}

enum RecordSource {
  SECRETARY
  WHATSAPP
}

enum AppointmentStatus {
  PENDING
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// Composite (id, organizationId) keys + composite foreign keys make it impossible at the
// database level for a row to reference data of another clinic. Relations use NoAction so
// deleting a clinic can cascade through every table.

model Dentist {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  active         Boolean       @default(true)
  /// Simple working window in the clinic's local time ("HH:MM") and weekdays (0 = Sunday).
  workStart      String        @default("08:00")
  workEnd        String        @default("18:00")
  workDays       Int[]         @default([1, 2, 3, 4, 5, 6])
  createdAt      DateTime      @default(now())
  appointments   Appointment[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("dentist")
}

model Procedure {
  id                    String        @id @default(uuid())
  organizationId        String
  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                  String
  defaultDurationMin    Int           @default(30)
  /// Months after a completed appointment to invite the patient back (module 1); null = never.
  reactivateAfterMonths Int?
  active                Boolean       @default(true)
  createdAt             DateTime      @default(now())
  appointments          Appointment[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("procedure")
}

model Patient {
  id              String           @id @default(uuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  /// AES-256-GCM payload (lib/crypto.ts); null for patients without CPF.
  cpfEncrypted    String?
  /// Keyed hash of the CPF digits, used for the per-clinic uniqueness rule.
  cpfHash         String?
  phoneE164       String
  birthDate       DateTime?        @db.Date
  status          PatientStatus    @default(CONFIRMED)
  source          RecordSource     @default(SECRETARY)
  consentAt       DateTime?
  consentSource   String?
  doNotContact    Boolean          @default(false)
  optedOutAt      DateTime?
  /// Set when the patient's data was erased on request (LGPD art. 18): the row stays only for the clinic's records.
  anonymizedAt    DateTime?
  /// For a dependent (a child, a relative): the name of the person who answers for them. The phone is theirs, and
  /// messages are addressed to them. Cleared when that person's data is erased.
  guardianName    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  appointments    Appointment[]
  quotes          Quote[]
  inboundMessages InboundMessage[]
  conversations   Conversation[]

  @@unique([id, organizationId])
  @@unique([organizationId, cpfHash])
  @@index([organizationId, name])
  @@index([organizationId, phoneE164])
  @@map("patient")
}

model Appointment {
  id                    String            @id @default(uuid())
  organizationId        String
  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientId             String
  dentistId             String
  procedureId           String
  patient               Patient           @relation(fields: [patientId, organizationId], references: [id, organizationId], onDelete: NoAction)
  dentist               Dentist           @relation(fields: [dentistId, organizationId], references: [id, organizationId], onDelete: NoAction)
  procedure             Procedure         @relation(fields: [procedureId, organizationId], references: [id, organizationId], onDelete: NoAction)
  startsAt              DateTime
  endsAt                DateTime
  status                AppointmentStatus @default(SCHEDULED)
  source                RecordSource      @default(SECRETARY)
  createdById           String?
  /// Set when the patient answered "2" (reschedule) on WhatsApp; the secretary follows up.
  rescheduleRequestedAt DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  reminders             Reminder[]

  @@unique([id, organizationId])
  @@index([organizationId, startsAt])
  @@index([dentistId, startsAt])
  @@map("appointment")
}

// ---------------------------------------------------------------------------
// M2: reminders. One row per (appointment, kind), recomputed in the same transaction
// as appointment changes (lib/reminders/sync.ts) and handed to n8n by polling
// (lib/reminders/dispatch.ts).
// ---------------------------------------------------------------------------

enum ReminderKind {
  CONFIRMATION
  REMINDER_24H
  REMINDER_2H
  NO_SHOW_FOLLOWUP
  /// Automatic answers to a patient's WhatsApp reply (1, 2, SAIR); sent through the same n8n flow.
  REPLY_CONFIRMED
  REPLY_RESCHEDULE
  REPLY_OPTED_OUT
  /// Module 1: invite the patient back N months after a completed appointment.
  REACTIVATION
  REPLY_INTERESTED
  REPLY_DECLINED
  /// Module 2: follow-ups after a quote was given (day 2 and day 7).
  QUOTE_FOLLOWUP_1
  QUOTE_FOLLOWUP_2
  /// Module 4: answers to a free-text message from a patient.
  REPLY_HANDOFF
  REPLY_AI
  /// Module 4: one turn of the booking conversation (text built by the app).
  REPLY_FLOW
}

/// What the patient answered to a campaign message (reactivation).
enum ReminderAnswer {
  INTERESTED
  DECLINED
}

enum ReminderStatus {
  /// Waiting for dueAt (also used while waiting to retry after a failure).
  PENDING
  /// Handed to n8n; waiting for its result.
  CLAIMED
  SENT
  /// Out of attempts: the secretary is alerted.
  FAILED
  /// No longer needed (appointment changed) or stale.
  CANCELLED
  /// Not allowed (opt-out, no consent).
  SKIPPED
}

model Reminder {
  id               String          @id @default(uuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Exactly one of appointmentId / quoteId / inboundMessageId / conversationId is set (CHECK constraint in the migration).
  appointmentId    String?
  appointment      Appointment?    @relation(fields: [appointmentId, organizationId], references: [id, organizationId], onDelete: NoAction)
  quoteId          String?
  quote            Quote?          @relation(fields: [quoteId, organizationId], references: [id, organizationId], onDelete: NoAction)
  inboundMessageId String?
  inboundMessage   InboundMessage? @relation(fields: [inboundMessageId, organizationId], references: [id, organizationId], onDelete: NoAction)
  conversationId   String?
  conversation     Conversation?   @relation(fields: [conversationId, organizationId], references: [id, organizationId], onDelete: NoAction)
  /// REPLY_FLOW: the inbound message this turn answers, so a repeated delivery is answered once.
  replyToMessageId String?
  /// Free text of an AI answer (REPLY_AI only); every other kind is rendered from a fixed template.
  text             String?
  kind             ReminderKind
  status           ReminderStatus  @default(PENDING)
  /// Earliest moment n8n may pick it up; moved forward on retries.
  dueAt            DateTime
  attempts         Int             @default(0)
  claimedAt        DateTime?
  sentAt           DateTime?
  /// Patient's answer to a campaign message, when it was given, and when the secretary dealt with it.
  answer           ReminderAnswer?
  answeredAt       DateTime?
  handledAt        DateTime?
  /// Why it was cancelled/skipped, or the last delivery error. Never holds message text or PII.
  note             String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([appointmentId, kind])
  @@unique([quoteId, kind])
  @@unique([inboundMessageId, kind])
  @@unique([conversationId, replyToMessageId])
  @@index([status, dueAt])
  @@index([organizationId, status])
  @@map("reminder")
}

// ---------------------------------------------------------------------------
// Module 2: quotes. The secretary records a quote; the app schedules follow-up reminders
// (lib/reminders/plan.ts) delivered through the same n8n flow as appointment reminders.
// ---------------------------------------------------------------------------

enum QuoteStatus {
  OPEN
  ACCEPTED
  DECLINED
}

model Quote {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient      @relation(fields: [patientId, organizationId], references: [id, organizationId], onDelete: NoAction)
  /// What was quoted ("Implante dente 36"); shown in the follow-up message.
  description    String
  valueCents     Int?
  status         QuoteStatus  @default(OPEN)
  closedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  reminders      Reminder[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@map("quote")
}

// ---------------------------------------------------------------------------
// Per-clinic message timings (decision CTX-DEC-20261017-clinic-defined-reminders). One row per
// clinic, created on first save; a clinic without a row uses lib/reminders/settings.ts defaults.
// ---------------------------------------------------------------------------

model ClinicSettings {
  organizationId       String       @id
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Message right after an appointment is booked.
  confirmationEnabled  Boolean      @default(true)
  /// First reminder (asks unconfirmed patients to confirm) and second reminder, in hours before the appointment.
  reminder1Enabled     Boolean      @default(true)
  reminder1HoursBefore Int          @default(24)
  reminder2Enabled     Boolean      @default(true)
  reminder2HoursBefore Int          @default(2)
  /// Invitation to reschedule after a no-show, in hours after the appointment ended.
  noShowEnabled        Boolean      @default(true)
  noShowDelayHours     Int          @default(1)
  /// Quote follow-ups (days after the quote) and how long a quote stays valid.
  quoteFollowup1Days   Int          @default(2)
  quoteFollowup2Days   Int          @default(7)
  quoteValidDays       Int          @default(14)
  /// No messages on the clinic's initiative during the quiet hours (local time); replies to a patient are exempt.
  quietEnabled         Boolean      @default(true)
  quietStartHour       Int          @default(21)
  quietEndHour         Int          @default(8)
  /// Messages handed to n8n per local day and clinic; replies are counted but never blocked.
  dailySendLimit       Int          @default(150)
  /// Name of the clinic's Evolution API instance (its WhatsApp number). Unique: it identifies the clinic of an
  /// inbound message, and tells n8n which instance to send through. Null = WhatsApp not connected yet.
  whatsappInstance     String?      @unique
  /// Welcome first contacts and guide them to a booking request (module 4); off = unknown numbers are ignored.
  bookingEnabled       Boolean      @default(true)
  /// Module 4 (opt-in): the clinic accepted that patients' messages go, masked, to an external AI provider.
  aiEnabled            Boolean      @default(false)
  aiEnabledAt          DateTime?
  aiEnabledBy          String?
  /// The clinic's own OpenRouter key, AES-256-GCM encrypted (same key as the CPFs); never shown again. Only the last
  /// characters are kept in clear so the screen can say which key is saved.
  aiApiKeyEncrypted    String?
  aiApiKeyLast4        String?
  /// What the AI may answer from: address, opening hours, payment methods and so on, written by the clinic.
  clinicInfo           String?
  updatedAt            DateTime     @updatedAt

  @@map("clinic_settings")
}

// ---------------------------------------------------------------------------
// LGPD: who did what with patient data. Append-only by convention (the app never updates or deletes
// rows). It deliberately holds no personal values: only ids, action names and changed field names.
// ---------------------------------------------------------------------------

enum AuditAction {
  PATIENT_CREATED
  PATIENT_UPDATED
  PATIENT_CONFIRMED
  CONSENT_RENEWED
  PATIENT_OPTED_OUT
  PATIENT_EXPORTED
  PATIENT_ANONYMIZED
  APPOINTMENT_BOOKED
  APPOINTMENT_STATUS_CHANGED
  APPOINTMENT_ANSWERED_BY_PATIENT
  QUOTE_CREATED
  QUOTE_CLOSED
  SETTINGS_UPDATED
  WHATSAPP_CHANGED
  AI_SETTINGS_CHANGED
  INBOUND_MESSAGE_HANDLED
  PATIENT_MESSAGE_ANSWERED_BY_AI
  CONVERSATION_CLEARED
}

enum AuditActor {
  USER
  SYSTEM
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// USER = a signed-in member (actorUserId); SYSTEM = the app acting on a patient's WhatsApp message.
  actorType      AuditActor
  actorUserId    String?
  action         AuditAction
  /// The patient concerned, when there is one. Not a foreign key: it must outlive an erasure.
  patientId      String?
  entityId       String?
  /// Names of changed fields and similar; never names, phones, CPFs or message text.
  details        Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, patientId, createdAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Module 4: free-text messages from known patients that no keyword explains. They wait here for a person
// (or are answered by the AI when the clinic opted in). The text is kept only while it is needed:
// it is cleared when the message is handled and when the patient's data is erased.
// ---------------------------------------------------------------------------

enum InboundStatus {
  OPEN
  HANDLED
}

enum InboundReason {
  UNRECOGNIZED
  URGENT
  AI_UNSURE
  AI_UNAVAILABLE
  AI_ANSWERED
}

model InboundMessage {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Null for a first contact who is not a patient yet.
  patientId      String?
  patient        Patient?      @relation(fields: [patientId, organizationId], references: [id, organizationId], onDelete: NoAction)
  /// Who wrote, when there is no patient to point at.
  phoneE164      String?
  /// Evolution's message id: the same delivery repeated is recognized and ignored.
  messageId      String
  /// Null once handled or erased.
  text           String?
  reason         InboundReason
  status         InboundStatus @default(OPEN)
  /// What the AI understood, when it looked at the message ("QUESTION", "YES", ...); never the text.
  aiIntent       String?
  handledAt      DateTime?
  createdAt      DateTime      @default(now())
  reminders      Reminder[]

  @@unique([id, organizationId])
  @@unique([organizationId, messageId])
  @@index([organizationId, status])
  @@map("inbound_message")
}

// ---------------------------------------------------------------------------
// Module 4: the booking conversation. A first contact (or a patient asking to book) is guided through
// procedure -> name -> slot -> confirmation; the app drives the dialog and offers only real free slots, the AI
// at most reads free text. The result is a PENDING appointment the secretary approves. Everything personal
// in here (name, offered slots) is cleared when the conversation ends or expires.
// ---------------------------------------------------------------------------

enum ConversationStep {
  PROCEDURE
  /// For themselves or for someone else (a child, a relative)?
  WHO
  /// The name of that other person.
  PERSON
  NAME
  SLOT
  CONFIRM
}

enum ConversationStatus {
  OPEN
  DONE
  HANDED_OFF
  EXPIRED
}

model Conversation {
  id              String             @id @default(uuid())
  organizationId  String
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  phoneE164       String
  /// Set when the person is already a patient, or once the request created one.
  patientId       String?
  patient         Patient?           @relation(fields: [patientId, organizationId], references: [id, organizationId], onDelete: NoAction)
  step            ConversationStep   @default(PROCEDURE)
  status          ConversationStatus @default(OPEN)
  procedureId     String?
  /// What the person said their name is; cleared when the conversation ends.
  name            String?
  /// true = for the person writing, false = for someone else, null = not asked yet.
  forSelf         Boolean?
  /// The other person's name when the appointment is for someone else; cleared when the conversation ends.
  personName      String?
  /// The slots last offered: [{ startsAt, dentistId }]; cleared when the conversation ends.
  slotOptions     Json?
  slotOffset      Int                @default(0)
  chosenStartsAt  DateTime?
  chosenDentistId String?
  /// Wrong answers in a row: after a few the person is handed to the secretary.
  misses          Int                @default(0)
  /// AI calls spent on this conversation (reading answers, writing questions).
  aiCalls         Int                @default(0)
  lastMessageId   String?
  appointmentId   String?
  expiresAt       DateTime
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  reminders       Reminder[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([status, expiresAt])
  @@map("conversation")
}

/// Messages waiting a few seconds so a person who writes several in a row gets one answer; deleted when processed.
model InboundBuffer {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instance       String
  phoneE164      String
  /// Evolution's message id: the same delivery repeated is recognized and ignored.
  messageId      String
  text           String
  receivedAt     DateTime     @default(now())

  @@unique([organizationId, messageId])
  @@index([receivedAt])
  @@map("inbound_buffer")
}

enum AiEventKind {
  /// A free-text answer in the booking dialog was read and sure enough to act on.
  TURN_READ
  /// The model read it but was not sure (below the confidence bar).
  TURN_UNSURE
  /// The model call failed (provider down, bad output).
  TURN_FAILED
  /// A question the model wrote passed validation and was sent.
  PHRASE_USED
  /// A question the model wrote was refused by validation: the fixed text went out instead.
  PHRASE_REJECTED
  /// The model call to write a question failed: the fixed text went out instead.
  PHRASE_FAILED
  /// A side question was answered from the clinic's information.
  ASIDE_ANSWERED
  /// A side-question answer was refused by validation.
  ASIDE_REJECTED
}

/// One thing the AI did in the booking dialog, for the quality screen. Counts only: never text or people.
model AiEvent {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           AiEventKind
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@map("ai_event")
}
